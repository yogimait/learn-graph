{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnGraph",
  "version": "0.1.0",
  "identifier": "com.learngraph.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LearnGraph",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      },
      {
        "label": "capture",
        "title": "LearnGraph Capture",
        "url": "index.html",
        "width": 560,
        "height": 140,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}